<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Typeforme</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(TYPEFORME_HOST_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>typeforme</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>TypeformeAppGroupIdentifier</key>
	<string>$(TYPEFORME_APP_GROUP_IDENTIFIER)</string>
	<key>TypeformeBundlePrefix</key>
	<string>$(TYPEFORME_BUNDLE_PREFIX)</string>
	<key>TypeformeHostBundleIdentifier</key>
	<string>$(TYPEFORME_HOST_BUNDLE_IDENTIFIER)</string>
	<key>TypeformeKeychainAccessGroup</key>
	<string>$(TYPEFORME_KEYCHAIN_ACCESS_GROUP)</string>
	<key>TypeformeKeyboardBundleIdentifier</key>
	<string>$(TYPEFORME_KEYBOARD_BUNDLE_IDENTIFIER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Typeforme uses the camera to scan the pairing QR code shown by the Mac app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Typeforme records your voice in the host app and sends audio to your paired Mac Bridge for transcription.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Typeforme connects to your paired Mac on the local network for dictation, settings, and keyboard status.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Typeforme can use Apple Speech for optional live preview while recording. On-device Only keeps preview audio on this iPhone; Cloud Fallback may use Apple servers for unsupported languages.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
